NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Mongo from `pnpm db:up` (single-node replica set). Use your Atlas URI in production.
MONGODB_URI=mongodb://localhost:27017/doctor-tracker?replicaSet=rs0

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Origin the browser uses (the Next.js app). Auth cookies are issued for this origin.
WEB_ORIGIN=http://localhost:3000
# Public URL of this API.
API_URL=http://localhost:4000
# Optional, comma-separated: other origins the app is also served from, such as a
# preview URL or a second domain. They may sign in; cookies still belong to WEB_ORIGIN.
TRUSTED_ORIGINS=

# Number of reverse proxies in front of the API (Traefik, Vercel rewrites). 0 when run directly.
TRUST_PROXY=0
# Optional: the header your outermost proxy sets to the caller's address and that callers
# cannot forge, such as cf-connecting-ip behind Cloudflare. Sign-in rate limiting counts per
# address from it. Leave empty when the API is reached directly or through one proxy.
CLIENT_IP_HEADER=

# Accounts that `pnpm seed` creates or updates. There are no defaults: choose your own.
# The admin pair is required until an active admin exists; after that, leave it blank and
# manage people from the Users page. Passwords need at least 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# Optional read-only account.
SEED_VIEWER_EMAIL=
SEED_VIEWER_PASSWORD=
SEED_VIEWER_NAME=
