NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Mongo from `pnpm db:up` (single-node replica set). Use your Atlas URI in production.
MONGODB_URI=mongodb://localhost:27017/doctor-tracker?replicaSet=rs0

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Origin the browser uses (the Next.js app). Auth cookies are issued for this origin.
WEB_ORIGIN=http://localhost:3000
# Public URL of this API.
API_URL=http://localhost:4000

# Number of reverse proxies in front of the API (Traefik, Vercel rewrites). 0 when run directly.
TRUST_PROXY=0

# Accounts created by `pnpm seed`
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_VIEWER_EMAIL=viewer@doctortracker.dev
SEED_VIEWER_PASSWORD=Viewer@12345
