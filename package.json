{
  "name": "doctor-tracker-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Doctor Tracker: doctors, patients and dashboard analytics",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:recount": "tsx --env-file-if-exists=.env src/db/recount.ts",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "openapi": "tsx --env-file-if-exists=.env src/openapi/write-spec.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.18",
    "@better-auth/mongo-adapter": "^1.7.18",
    "@scalar/express-api-reference": "^0.10.35",
    "better-auth": "^1.7.18",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongodb": "7.8.0",
    "mongoose": "^9.12.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
